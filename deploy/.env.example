# wyoming-vulkan settings: copy to .env next to compose.yaml and adjust. Relative paths are relative to this folder.

# Image built from the project: docker build -t wyoming-vulkan:latest .
WYOMING_VULKAN_IMAGE=wyoming-vulkan:latest
CONTAINER_NAME=wyoming-vulkan

# Host ports (Home Assistant: add one Wyoming integration per port)
# Parakeet speech-to-text + all voices
WYOMING_PORT=10310
# Whisper speech-to-text
WHISPER_PORT=10311

# User the server runs as (must read the model/voice folders) and the host's render group: getent group render
PUID=1000
PGID=1000
RENDER_GID=993
# The GPU's render node; with several GPUs pin it by PCI address, e.g. /dev/dri/by-path/pci-0000:00:02.0-render
RENDER_DEVICE=/dev/dri/renderD128
# How the GPU is recognised (Vulkan device name, PCI vendor). Intel: "Intel" / 0x8086. Other GPUs are untested.
GPU_NAME_CONTAINS=Intel
GPU_VENDOR_ID=0x8086
# auto = GPU with CPU fallback (shown in Home Assistant as "[CPU fallback]"), igpu = refuse to start without it, cpu
WYOMING_DEVICE=auto

# Speech-to-text models in MODELS_DIR (scripts/fetch-models.sh --list)
MODELS_DIR=./models
PARAKEET_MODEL=ggml-parakeet-tdt-0.6b-v3-q8_0.bin
# Languages Parakeet offers to Home Assistant (comma-separated), or auto = all 25 of Parakeet v3:
# bg,cs,da,de,el,en,es,et,fi,fr,hr,hu,it,lt,lv,mt,nl,pl,pt,ro,ru,sk,sl,sv,uk (Whisper always offers all of its own)
PARAKEET_LANGUAGES=en
WHISPER_MODEL=ggml-small.bin
WHISPER_DESCRIPTION=Whisper small
# Whisper encoder window in 20 ms frames: 512 = ~10 s (about 3x faster for commands; longer audio automatically
# uses the full window), 0 = always the full 30 s
WHISPER_AUDIO_CTX=512
STT_THREADS=4

# Voices: the default voice is VOICES_DIR/<DEFAULT_VOICE>.onnx + .onnx.json; every voice in the voice folders is
# offered to Home Assistant and loaded on first use (at most MAX_LOADED_VOICES at once)
VOICES_DIR=./voices
DEFAULT_VOICE=en_US-ljspeech-high
DEFAULT_VOICE_LANGUAGE=en_US
MAX_LOADED_VOICES=2
# Optional extra voice folders, e.g. network shares
VOICE_LIBRARY_DIR=./voice-library
EXTRA_VOICES_DIR=./voices-extra
# Files in the extra folder changed less than this many seconds ago are skipped (still being written)
EXTRA_VOICES_MIN_AGE=60
