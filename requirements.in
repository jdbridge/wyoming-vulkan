wyoming==1.10.2                # 2026-08-27, latest; wyoming-piper 2.5.2 and wyoming-faster-whisper 3.8.1 require >= 1.10.2
sentence-stream==1.3.0         # 2026-01-08, latest; sentence splitting for streaming TTS, as in wyoming-piper
numpy==2.5.3                   # 2026-09-06, latest
